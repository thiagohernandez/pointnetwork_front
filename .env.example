# PointNetwork Email Configuration
SMTP_HOST=mail.pointnetwork.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@pointnetwork.com.br
SMTP_PASSWORD=your-email-password

# PointNetwork Email Settings:
# - Host: mail.pointnetwork.com.br
# - SMTP Port: 465 (secure SSL/TLS)
# - Username: contato@pointnetwork.com.br
# - Password: Use your email account password
# - Authentication: Required
# - IMAP Port: 993, POP3 Port: 995 (for receiving emails)

# Alternative providers (for reference):
# Gmail: smtp.gmail.com, port 587, secure false (needs App Password)
# Outlook: smtp-mail.outlook.com, port 587, secure false
# Yahoo: smtp.mail.yahoo.com, port 587, secure false